{
  "name": "@openglyph/dsh-openglyph",
  "version": "0.2.1",
  "description": "Native OpenGlyph document, glyph search, structural composition and printable-font tools for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "data",
    "docs",
    "skills",
    "runtime",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Glyph/OpenGlyph-DeepSeek-Harness.git"
  },
  "homepage": "https://github.com/Open-Glyph/OpenGlyph-DeepSeek-Harness#readme",
  "author": "Zejia FAN",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openglyph",
    "guwenzi",
    "paleography",
    "kage",
    "latex"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@resvg/resvg-wasm": "2.6.2",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5"
  }
}
